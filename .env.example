# Application delivery. Both sinks are optional and attempted independently:
# whichever you configure will receive applications. See SETUP.md.

# --- Email (Resend) ---
RESEND_API_KEY=
APPLY_TO_EMAIL=
# Optional. Defaults to Resend's shared sender, which needs no domain setup.
APPLY_FROM_EMAIL=

# --- Google Sheet (Apps Script web app) ---
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# --- Site ---
# Canonical origin, used for metadata and the social card.
NEXT_PUBLIC_SITE_URL=
